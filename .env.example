# Environment Configuration
# Copy this file to .env and fill in values

# Database
DB_PASSWORD=changeme_in_production
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user

# Backend
SECRET_KEY=changeme_generate_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+asyncpg://lms_user:${DB_PASSWORD}@db:5432/lms_db

# Frontend
VITE_API_URL=/api

# Seed (librarian admin)
ADMIN_EMAIL=admin@university.ac.id
ADMIN_PASSWORD=changeme_admin_password
